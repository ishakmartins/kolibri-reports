---
import Base from '../layouts/Base.astro';
import reports from '../data/reports.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// reports.json is already sorted by date, most recent first (scripts/cms.py)
---
<Base title="Kolibri reports">
  <h1>Kolibri reports</h1>

  <!-- EDIT: intro paragraph -->
  <p class="intro">
    This page houses results and reports on inauthentic amplification detection for
    selected trending topics in the Indonesian Twitter/X space. For feedback and
    requests, please send email to <a href="mailto:feedback-kolibri@lokanetra.dev">feedback-kolibri@lokanetra.dev</a>.
  </p>

  <div class="wrap">
  <table>
    <thead>
      <tr>
        <th>UUID</th><th>Title</th><th>Date published</th>
        <th>Report Page</th><th>DOI (Zenodo)</th><th>Kolibri version</th>
      </tr>
    </thead>
    <tbody>
      {reports.map((r) => (
        <tr>
          <td class="uuid">{r.uuid}</td>
          <td class="title">{r.title}</td>
          <td class="date">{r.date}</td>
          <td><a href={`${base}/${r.reportLink}/`}>Open report</a></td>
          <td><a href={`https://doi.org/${r.doi}`}>{r.doi}</a></td>
          <td class="ver">{r.version}</td>
        </tr>
      ))}
    </tbody>
  </table>
  {reports.length === 0 && <p class="empty">No reports published yet.</p>}
  </div>
</Base>
