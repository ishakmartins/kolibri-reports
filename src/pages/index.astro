---
import Base from '../layouts/Base.astro';
import packets from '../data/packets.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// packets.json is already sorted by Date published, most recent first, with
// isFirstOfDate/dateRowSpan precomputed for the grouped date cell (scripts/cms.py) --
// keep that grouping logic in one place rather than recomputing it here from a flat array.
---
<Base title="Kolibri reports">
  <h1>Kolibri reports</h1>

  <!-- EDIT: intro paragraph -->
  <p class="intro">
    This page houses results and reports on inauthentic amplification detection for
    selected trending topics in the Indonesian Twitter/X space. For feedback and
    requests, please send email to <a href="mailto:feedback-kolibri@lokanetra.dev">feedback-kolibri@lokanetra.dev</a>.
  </p>

  <p class="callout">
    Kolibri is best paired with
    <a href="https://open.lokanetra.dev/kestrel-trending/">Kestrel-Trending</a>.
  </p>

  <div class="wrap">
  <table>
    <thead>
      <tr>
        <th>Date published</th><th>Keywords</th><th>Date start</th><th>Date end</th>
        <th>Analysis</th><th>Volume (collected)</th><th>Total estimated engagement</th>
      </tr>
    </thead>
    <tbody>
      {packets.map((p) => (
        <tr>
          {p.isFirstOfDate && <td class="date" rowspan={p.dateRowSpan}>{p.published}</td>}
          <td>{p.keywords}</td>
          <td class="date">{p.dateStart}</td>
          <td class="date">{p.dateEnd}</td>
          <td>{p.analysis
            ? <a href={`${base}/${p.analysis}/`}>Open report</a>
            : 'REPORT NOT AVAILABLE'}</td>
          <td class="num">{p.volume.toLocaleString()}</td>
          <td class="num">{p.totalEngagement.toLocaleString()}</td>
        </tr>
      ))}
    </tbody>
  </table>
  {packets.length === 0 && <p class="empty">No packets published yet.</p>}
  </div>
</Base>

<style>
  .callout{border:1px solid var(--bd);border-left:3px solid var(--acc);border-radius:2px;
    padding:.9rem 1.2rem;margin:0 0 3rem;max-width:62ch;color:var(--fg2)}
  .callout a{color:var(--fg)}
  .callout a:hover{color:var(--acc)}
  td.num{text-align:right}
</style>
